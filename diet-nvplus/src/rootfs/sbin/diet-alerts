#!/bin/sh
# Affiche sur une ligne les problèmes en cours (RAID, disques, SMART) ; rien si tout va bien.
# Appelé chaque minute par diet-hwmon, qui notifie quand cette ligne change.
XR=${DIET_XRAID:-/proc/xraid/configuration}; MD=${DIET_MDSTAT:-/proc/mdstat}; RUN=${DIET_RUN:-/var/run}
[ -r ${DIET_ETC:-/etc}/diet-lang.sh ] && . ${DIET_ETC:-/etc}/diet-lang.sh || tx() { printf "%s" "$3"; }
A=""
add() { A="${A:+$A ; }$1"; }
if [ -r "$XR" ]; then
  x=$(sed -n 's/^LOGICAL_DRIVE:\([0-9]*\):.*status=\([^,]*\).*/\1=\2/p' "$XR" | grep -v '=redundant$' | tr '\n' ' ')
  [ -n "$x" ] && add "$(tx "RAID dégradé (volume ${x% })" "RAID beeinträchtigt (Volume ${x% })" "RAID degraded (volume ${x% })")"
  x=$(sed -n 's/^PHYSICAL_DRIVE:.*device=\([^,]*\),.*state=\([^,]*\),.*/\1=\2/p' "$XR" | grep -v '=online$' | tr '\n' ' ')
  [ -n "$x" ] && add "$(tx "disque hors du RAID (${x% })" "Platte nicht im RAID (${x% })" "disk out of the RAID (${x% })")"
fi
x=$(awk '/^md[0-9]+ :/ { n=$1 } /\[[U_]*_[U_]*\]/ { printf "%s ", n }' "$MD" 2>/dev/null)
[ -n "$x" ] && add "$(tx "RAID dégradé (${x% })" "RAID beeinträchtigt (${x% })" "RAID degraded (${x% })")"
[ -s "$RUN/disk_alarm" ] && { da=$(tail -1 "$RUN/disk_alarm"); add "$(tx "alarme disque ($da)" "Plattenalarm ($da)" "disk alarm ($da)")"; }
for f in "$RUN"/smart.*; do
  [ -r "$f" ] || continue
  health=""; realloc=0; pending=0; uncorr=0; . "$f"
  p=""
  [ -n "$health" ] && [ "$health" != PASSED ] && p="SMART $health"
  [ "$realloc" -gt 0 ] && p="${p:+$p, }$(tx "$realloc secteurs réalloués" "$realloc Sektoren umgelagert" "$realloc reallocated sectors")"
  [ "$pending" -gt 0 ] && p="${p:+$p, }$(tx "$pending secteurs en attente" "$pending Sektoren ausstehend" "$pending pending sectors")"
  [ "$uncorr" -gt 0 ] && p="${p:+$p, }$(tx "$uncorr secteurs illisibles" "$uncorr Sektoren unlesbar" "$uncorr unreadable sectors")"
  [ -n "$p" ] && add "$(tx "${f##*.} : $p" "${f##*.}: $p" "${f##*.}: $p")"
done
echo "$A"

#!/bin/sh
# Einmalig RAIDiator starten (danach wieder DIET)
[ -r ${DIET_ETC:-/etc}/diet-lang.sh ] && . ${DIET_ETC:-/etc}/diet-lang.sh || tx() { printf "%s" "$3"; }
grep -q " /mnt/root " /proc/mounts || mount $(cat /etc/diet-rootdev 2>/dev/null || echo /dev/md0) /mnt/root
: > /mnt/root/.raidiator_once && echo "$(tx "Prochain démarrage : RAIDiator (une seule fois). Redémarrage..." "Nächster Start: RAIDiator (einmalig). Neustart..." "Next boot: RAIDiator (once). Restarting...")" && sleep 1 && reboot

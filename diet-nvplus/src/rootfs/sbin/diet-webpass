#!/bin/sh
# Passwort fuer die Web-Oberflaeche setzen (Benutzer: $1, Standard admin)
U=${1:-admin}
case "$U" in *[!a-zA-Z0-9_-]*|"") echo "Nom d’utilisateur invalide"; exit 1;; esac
printf "Nouveau mot de passe web pour %s : " "$U"; stty -echo; read -r P; stty echo; echo
printf "Encore une fois : "; stty -echo; read -r P2; stty echo; echo
[ ${#P} -ge 6 ] || { echo "Abandon : 6 caractères minimum"; exit 1; }
[ "$P" = "$P2" ] || { echo "Abandon : les deux saisies diffèrent"; exit 1; }
case "$P" in *:*) echo "Abandon : pas de deux-points dans le mot de passe"; exit 1;; esac
H=$(httpd -m "$P")
umask 077
cat > /etc/httpd.conf.new <<EOC
# nur aus dem Heimnetz erreichbar
A:192.168.0.0/16
A:10.0.0.0/8
A:172.16.0.0/12
A:127.0.0.1
D:*
# alles hinter Passwort
/:$U:$H
.json:application/json
.svg:image/svg+xml
EOC
mv /etc/httpd.conf.new /etc/httpd.conf
if pidof httpd >/dev/null; then killall -HUP httpd; echo "Mot de passe modifié."
else
  httpd -p 80 -h /www -c /etc/httpd.conf -r "$(hostname)" && echo "Interface web lancée : http://$(ifconfig eth0 | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')/"
fi

#!/bin/sh
# Temperatur-/Luefterregelung, Plattenueberwachung, Display (laeuft im DIET-System)
. /etc/diet.conf
LOG=/var/log/boot.log
ST=/var/run/hwmon.status
H=/proc/sys/dev/hwmon
DISKS=""; for d in hdc hde hdg hdi; do [ -d /proc/ide/$d ] && DISKS="$DISKS $d"; done
log() { echo "[$(cut -d' ' -f1 /proc/uptime)] hwmon: $*" >> $LOG; }
lcd() { [ -e /proc/sys/dev/lcd/cmd ] || return; echo $1 > /proc/sys/dev/lcd/cmd; printf "%-16s" "$2" > /dev/lcd; }
LASTPWM=-1; N=0; DTMAX=0; DTXT=""; HOT=0; LCDON=$(cut -d. -f1 /proc/uptime)
while true; do
  T=$(cut -d. -f1 $H/temp_0 2>/dev/null); T=${T:-0}
  RPM=$(cat $H/fan_0 2>/dev/null)
  # Plattentemperaturen alle 5 Minuten (weckt schlafende Platten NICHT)
  if [ $((N % 5)) -eq 0 ]; then
    DTMAX=0; DTXT=""
    for d in $DISKS; do
      out=$(smartctl -n standby -A /dev/$d 2>/dev/null)
      if echo "$out" | grep -q "STANDBY"; then DTXT="$DTXT $d:schlaeft"; continue; fi
      dt=$(echo "$out" | awk '$1==194 || $1==190 {print $10; exit}')
      [ -n "$dt" ] || continue
      DTXT="$DTXT $d:${dt}C"; [ "$dt" -gt "$DTMAX" ] && DTMAX=$dt
    done
  fi
  # Luefterstufe: linear zwischen TEMP_LOW und TEMP_HIGH, Platten koennen hochziehen
  if [ $T -le $TEMP_LOW ]; then P=$FAN_PWM_MIN
  elif [ $T -ge $TEMP_HIGH ]; then P=$FAN_PWM_MAX
  else P=$(( FAN_PWM_MIN + (T - TEMP_LOW) * (FAN_PWM_MAX - FAN_PWM_MIN) / (TEMP_HIGH - TEMP_LOW) )); fi
  [ $DTMAX -ge $DISK_HIGH ] && P=$FAN_PWM_MAX
  if [ $P -ne $LASTPWM ]; then echo $P > $H/fan0_speed_control; LASTPWM=$P; fi
  # Alarm / Notabschaltung (2 Messungen in Folge)
  if [ $T -ge $TEMP_CRIT -o $DTMAX -ge $DISK_CRIT ]; then HOT=$((HOT+1)); log "UEBERTEMPERATUR Board=${T}C Platten=${DTMAX}C ($HOT)"
    echo 1 > /proc/sys/dev/lcd/backlight; lcd 2 "UEBERTEMP ${T}C"
    if [ $HOT -ge 2 ]; then log "Notabschaltung!"; : > /var/run/poweroff; poweroff; fi
  else HOT=0; fi
  [ "$RPM" -lt 300 ] 2>/dev/null && log "WARNUNG: Luefter ${RPM} U/min"
  # Status fuer Web-Oberflaeche
  echo "temp=$T fan=$RPM pwm=$P disks=\"$DTXT\" uptime=$(cut -d' ' -f1 /proc/uptime)" > $ST
  # Display: Zeile 1 Name+Temp, Zeile 2 IP bzw. Alarm
  IP=$(ifconfig eth0 | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')
  [ $HOT -eq 0 ] && lcd 2 "$(hostname | cut -c1-10) ${T}C"
  if [ -s /var/run/disk_alarm ]; then lcd 192 "$(tail -1 /var/run/disk_alarm)"; else lcd 192 "$IP"; fi
  [ -s /var/run/lcd_on ] && LCDON=$(cat /var/run/lcd_on) && rm -f /var/run/lcd_on
  NOW=$(cut -d. -f1 /proc/uptime)
  if [ $LCD_TIMEOUT -gt 0 ] && [ $((NOW - LCDON)) -ge $LCD_TIMEOUT ] && [ $HOT -eq 0 ] && [ ! -s /var/run/disk_alarm ]; then echo 0 > /proc/sys/dev/lcd/backlight; fi
  N=$((N+1)); sleep 60
done

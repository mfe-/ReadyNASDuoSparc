#!/bin/sh
# DIET-System Start (ReadyNAS NV+ v1)
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export TZ=$(cat /etc/TZ 2>/dev/null)
. /etc/diet.conf
[ -r ${DIET_ETC:-/etc}/diet-lang.sh ] && . ${DIET_ETC:-/etc}/diet-lang.sh || tx() { printf "%s" "$3"; }
LOG=/var/log/boot.log
log() { echo "[$(cut -d' ' -f1 /proc/uptime)] $*" >> $LOG; }
lcd() {
  [ -e /proc/sys/dev/lcd/cmd ] || return 0
  echo 1 > /proc/sys/dev/lcd/backlight
  echo $1 > /proc/sys/dev/lcd/cmd
  printf "%-16s" "$2" > /dev/lcd
}
mount -t proc proc /proc
mount -t sysfs sysfs /sys 2>/dev/null
mkdir -p /dev/pts; mount -t devpts devpts /dev/pts 2>/dev/null
# fluechtige Verzeichnisse im RAM, damit die Platten schlafen koennen
for d in /var/run /var/lock /var/log/samba /tmp; do mkdir -p $d; mount -t tmpfs -o size=8m tmpfs $d; done
chmod 1777 /tmp
mkdir -p /var/lock/lvm /var/lock/samba /var/ncalrpc
log "$(tx "==== DIET $(cat /etc/diet-version) démarre ====" "==== DIET $(cat /etc/diet-version) startet ====" "==== DIET $(cat /etc/diet-version) starting ====")"
lcd 2 "DIET $(cat /etc/diet-version)"

# --- Hardware: Power-Knopf + Kernel-Ereignisse ---
echo 1 > /proc/sys/dev/hwmon/POWER_SWITCH
echo /sbin/diet-hotplug > /proc/sys/kernel/hotplug
log "$(tx "Bouton d’alimentation actif, hotplug -> $(cat /proc/sys/kernel/hotplug)" "Power-Knopf aktiv, hotplug -> $(cat /proc/sys/kernel/hotplug)" "Power button active, hotplug -> $(cat /proc/sys/kernel/hotplug)")"

hostname -F /etc/hostname
ifconfig lo 127.0.0.1 up
ifconfig eth0 up
# Netz: /etc/diet-net.conf (NET=dhcp|static, IPADDR, NETMASK, GATEWAY, DNS, FALLBACK_IP)
NET=dhcp; IPADDR=""; NETMASK=255.255.255.0; GATEWAY=""; DNS=""; FALLBACK_IP=""
[ -f /etc/diet-net.conf ] && . /etc/diet-net.conf
if [ "$NET" = "static" ] && [ -n "$IPADDR" ]; then
  ifconfig eth0 $IPADDR netmask $NETMASK up
  [ -n "$GATEWAY" ] && route add default gw $GATEWAY
  if [ -n "$DNS" ]; then : > /etc/resolv.conf; for n in $DNS; do echo "nameserver $n" >> /etc/resolv.conf; done; fi
  log "$(tx "Réseau statique : $IPADDR" "Netz statisch: $IPADDR" "Static network: $IPADDR")"
elif udhcpc -n -t 5 -T 3 -i eth0 -x hostname:$(hostname) -p /var/run/udhcpc.pid -s /usr/share/udhcpc/default.script >> /tmp/udhcpc.log 2>&1; then
  log "DHCP ok"
elif [ -n "$FALLBACK_IP" ]; then
  ifconfig eth0 $FALLBACK_IP netmask $NETMASK; log "$(tx "Échec DHCP -> $FALLBACK_IP" "DHCP fehlgeschlagen -> $FALLBACK_IP" "DHCP failed -> $FALLBACK_IP")"
else log "$(tx "Échec DHCP, aucune adresse" "DHCP fehlgeschlagen, keine Adresse" "DHCP failed, no address")"; fi
IP=$(ifconfig eth0 | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')
lcd 192 "$IP"
ntpd -q -n -p pool.ntp.org >> $LOG 2>&1 && log "$(tx "Heure réglée : $(date)" "Zeit gesetzt: $(date)" "Time set: $(date)")" &
if dropbear -R -p 22 >> $LOG 2>&1; then log "$(tx "dropbear (SSH) actif sur $IP:22" "dropbear (SSH) läuft auf $IP:22" "dropbear (SSH) running on $IP:22")"
else log "$(tx "ERREUR dropbear -> telnetd de secours" "dropbear FEHLER -> Notfall-telnetd" "dropbear ERROR -> emergency telnetd")"; telnetd -l /bin/sh; fi
syslogd -C64 2>/dev/null

# --- Datenvolume /c ---
lvm vgscan --ignorelockingfailure --mknodes >> $LOG 2>&1
lvm vgchange -ay --ignorelockingfailure >> $LOG 2>&1
if [ -b /dev/c/c ]; then
  if mount -t ext3 -o noatime,data=ordered,acl,user_xattr /dev/c/c /c 2>>$LOG; then log "$(tx "/c monté (ext3)" "/c eingehängt (ext3)" "/c mounted (ext3)")"
  elif mount -t ext2 -o noatime,acl,user_xattr /dev/c/c /c 2>>$LOG; then log "$(tx "/c monté (ext2)" "/c eingehängt (ext2)" "/c mounted (ext2)")"
  else log "$(tx "ERREUR : impossible de monter /c" "FEHLER: /c konnte nicht eingehängt werden" "ERROR: cannot mount /c")"; fi
else log "$(tx "ERREUR : /dev/c/c introuvable" "FEHLER: /dev/c/c nicht gefunden" "ERROR: /dev/c/c not found")"; fi
grep -q " /c " /proc/mounts && log "$(df -h /c | tail -1)"

# --- Platten-Standby ---
if [ "$SPINDOWN_MIN" -gt 0 ]; then
  if [ $SPINDOWN_MIN -le 20 ]; then S=$((SPINDOWN_MIN * 12)); else S=$((240 + SPINDOWN_MIN / 30)); fi
  for d in hdc hde hdg hdi; do [ -d /proc/ide/$d ] && hdparm -S $S /dev/$d >/dev/null 2>&1; done
  log "$(tx "Mise en veille des disques après $SPINDOWN_MIN min (hdparm -S $S)" "Platten-Standby nach $SPINDOWN_MIN min (hdparm -S $S)" "Disk spin-down after $SPINDOWN_MIN min (hdparm -S $S)")"
fi

# --- Dienste ---
if grep -q " /c " /proc/mounts; then
  [ -f /etc/rsyncd.conf ] && rsync --daemon --config=/etc/rsyncd.conf && log "$(tx "service rsync actif" "rsync-Dienst läuft" "rsync service running")"
  nmbd -D && log "$(tx "nmbd actif" "nmbd läuft" "nmbd running")"
  smbd -D && log "$(tx "smbd (Samba $(smbd -V)) actif" "smbd (Samba $(smbd -V)) läuft" "smbd (Samba $(smbd -V)) running")"
fi

# --- NFS (Kernel-nfsd), nur wenn /etc/exports Freigaben enthaelt ---
if grep -q "^/" /etc/exports 2>/dev/null && grep -q " /c " /proc/mounts; then
  /sbin/diet-nfs start >> $LOG 2>&1 && log "$(tx "NFS actif" "NFS läuft" "NFS running")"
fi

# --- Web-Oberflaeche (startet nur, wenn ein Passwort gesetzt ist) ---
if grep -q '^/:' /etc/httpd.conf 2>/dev/null; then
  httpd -p 80 -h /www -c /etc/httpd.conf -r "$(hostname)" && log "$(tx "Interface web active : http://$IP/" "Web-Oberfläche läuft: http://$IP/" "Web interface running: http://$IP/")"
else log "$(tx "Interface web désactivée : lancer d’abord diet-webpass" "Web-Oberfläche aus: zuerst diet-webpass ausführen" "Web interface off: run diet-webpass first")"; fi

# --- Ueberwachung: Temperatur, Luefter, Platten, Display ---
/sbin/diet-hwmon &
log "$(tx "surveillance lancée (carte $(cat /proc/sys/dev/hwmon/temp_0)C, ventilateur $(cat /proc/sys/dev/hwmon/fan_0) tr/min)" "hwmon gestartet (Board $(cat /proc/sys/dev/hwmon/temp_0)C, Lüfter $(cat /proc/sys/dev/hwmon/fan_0) U/min)" "monitoring started (board $(cat /proc/sys/dev/hwmon/temp_0)C, fan $(cat /proc/sys/dev/hwmon/fan_0) rpm)")"

# Boot-Erfolg melden: Weichensteller startet beim naechsten Mal wieder DIET
grep -q " /mnt/root " /proc/mounts || mount $(cat /etc/diet-rootdev 2>/dev/null || echo /dev/md0) /mnt/root 2>/dev/null
if pidof dropbear >/dev/null && rm -f /mnt/root/.diet_pending; then log "$(tx "Démarrage réussi (DIET reste le système par défaut)" "Start erfolgreich (DIET bleibt Standard)" "Boot successful (DIET stays the default)")"
else log "$(tx "ATTENTION : marque de réussite non posée -> prochain démarrage sous RAIDiator" "WARNUNG: Erfolgsmarke nicht gesetzt -> nächster Start in RAIDiator" "WARNING: success mark not set -> next boot into RAIDiator")"; fi
# --- LEDs: gruene Platten-LEDs an (P0-Board: disk_N_fault=1 heisst "Platte da"), Power-LED ruhig ---
ch=1; for d in hdc hde hdg hdi; do [ -d /proc/ide/$d ] && echo 1 > /proc/sys/dev/led/disk_${ch}_fault; ch=$((ch+1)); done
echo 1 > /proc/sys/dev/led/power
MF=$(awk '/^MemFree:/{print $2}' /proc/meminfo); MU=$(( $(awk '/^MemTotal:/{print $2}' /proc/meminfo) - MF ))
log "$(tx "prêt (mémoire : $MU ko utilisés, $MF ko libres)" "bereit (Speicher: $MU kB belegt, $MF kB frei)" "ready (memory: $MU kB used, $MF kB free)")"

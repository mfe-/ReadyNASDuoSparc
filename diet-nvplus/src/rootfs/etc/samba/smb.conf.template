[global]
    workgroup = @WORKGROUP@
    netbios name = @NETBIOS@
    server string = ReadyNAS NV+ (DIET)
    security = user
    passdb backend = smbpasswd:/etc/samba/smbpasswd
    map to guest = Bad User
    guest account = nobody
    max protocol = SMB2
    load printers = no
    printing = bsd
    printcap name = /dev/null
    disable spoolss = yes
    log file = /var/log/samba/log.%m
    max log size = 200
    log level = 1
    unix charset = UTF-8
    dos charset = CP437
    # Tempo auf der langsamen CPU
    use sendfile = yes
    socket options = TCP_NODELAY IPTOS_LOWDELAY SO_RCVBUF=131072 SO_SNDBUF=131072
    strict allocate = no
    strict locking = no
    getwd cache = yes
    kernel oplocks = no
    dns proxy = no
    unix extensions = no
    create mask = 0664
    directory mask = 0775

# Freigaben (bei der Installation aus RAIDiator uebernommen)
include = /etc/samba/shares.conf
